{
  "name": "pisomday-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun scripts/build.ts",
    "dev": "bun run build && bun scripts/serve.ts",
    "preview": "bun scripts/serve.ts",
    "lint": "biome check src scripts tests",
    "format": "biome check --write src scripts tests",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "^1.64.1",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
